{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:revision",
  "outputDirectory": "build",
  "build": {
    "env": {
      "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD": "1"
    }
  },
  "redirects": [
    { "source": "/compra-venta-de-maquinaria/", "destination": "/venta/", "permanent": false },
    { "source": "/compra-venta-de-maquinaria", "destination": "/venta/", "permanent": false },
    { "source": "/fletes-y-logistica/", "destination": "/fletes/", "permanent": false },
    { "source": "/fletes-y-logistica", "destination": "/fletes/", "permanent": false },
    { "source": "/taller-y-refaccionaria/", "destination": "/taller/", "permanent": false },
    { "source": "/taller-y-refaccionaria", "destination": "/taller/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
